[Unit]
Description=Shivani Pipeline Orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
WorkingDirectory=/yash-superClaudeHuman/projects/yash-ai-automation-career
EnvironmentFile=/etc/shivani-pipeline/agent.env
ExecStart=/usr/bin/env node services/pipeline-orchestrator.mjs
Restart=on-failure
RestartSec=5
WatchdogSec=300
# Match the Yash orchestrator's 60s budget — gives the WAL checkpoint, sqlite init,
# and `git rev-parse` breathing room after a heavy back-to-back restart.
TimeoutStartSec=60
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM
# Plan §5.2: a single Opus 4.7 claude -p worker peaks ~500 MB RSS + tectonic spikes
# can push to ~1.5 GB. 1G cgroup cap leaves clean headroom for cat-chunked V3.1
# prompt + cover-letter compile on the existing 4 GB VPS (two tenants share the box).
MemoryMax=1G
# Plan §5.3 / Q3: bias OOM-killer to prefer killing the claude-p child over the
# orchestrator parent. Without this, an OOM on the worker can take down the
# orchestrator and orphan the run. Yash unit is unchanged by this PR; the plan
# notes applying the same hardening to Yash is a small follow-up.
OOMScoreAdjust=-500
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
