# /etc/yash-pipeline/agent.env  (canonical location; this file is the repo template)
# chmod 600, chown yash:yash before use.
TELEGRAM_BOT_TOKEN=000000000:REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_ALLOWLIST=0000000000
TELEGRAM_NOTIFY_CHAT_ID=0000000000
PROJECT_ROOT=/yash-superClaudeHuman/projects/yash-ai-automation-career
WORK_QUEUE_DB=/yash-superClaudeHuman/projects/yash-ai-automation-career/ops/work-queue.db
CHECKPOINT_DIR=/yash-superClaudeHuman/projects/yash-ai-automation-career/ops/checkpoints
RUNS_DIR=/yash-superClaudeHuman/projects/yash-ai-automation-career/ops/runs

# ── Structured logging (pino) ────────────────────────────────────────────────
# LOG_LEVEL: trace|debug|info|warn|error|fatal (default: info)
# LOG_TRANSPORT: none|betterstack (default: none → stdout-only, journald captures)
# LOGTAIL_TOKEN: required iff LOG_TRANSPORT=betterstack
LOG_LEVEL=info
LOG_TRANSPORT=none
# LOGTAIL_TOKEN=
