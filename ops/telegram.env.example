# /etc/yash-pipeline/agent.env  (canonical location; this file is the repo template)
# chmod 600, chown yash:yash before use.
TELEGRAM_BOT_TOKEN=000000000:REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_ALLOWLIST=0000000000
TELEGRAM_NOTIFY_CHAT_ID=0000000000
PROJECT_ROOT=/yash-superClaudeHuman/projects/yash-ai-automation-career
WORK_QUEUE_DB=/yash-superClaudeHuman/projects/yash-ai-automation-career/ops/work-queue.db
CHECKPOINT_DIR=/yash-superClaudeHuman/projects/yash-ai-automation-career/ops/checkpoints
RUNS_DIR=/yash-superClaudeHuman/projects/yash-ai-automation-career/ops/runs

# ── Structured logging (pino) ────────────────────────────────────────────────
# LOG_LEVEL: trace|debug|info|warn|error|fatal (default: info)
# LOG_TRANSPORT: none|betterstack (default: none → stdout-only, journald captures)
# LOGTAIL_TOKEN: required iff LOG_TRANSPORT=betterstack
LOG_LEVEL=info
LOG_TRANSPORT=none
# LOGTAIL_TOKEN=

# --- Self-Improvement Overlay (Phases A/B/C/D — all default OFF) ---

# Phase A: Observability exporter to Langfuse Cloud Hobby
FEATURE_EXPORTER=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Phase B: Failure-pattern KB + preamble injection
FEATURE_FAILURE_KB=0

# Phase C: Watchdog + Healthchecks.io heartbeat
FEATURE_WATCHDOG=0
HEALTHCHECK_PING_URL=

# ── Claude model + thinking budget ───────────────────────────────────────────
# As of 2026-05-28 the orchestrator defaults to Sonnet 4.6 + adaptive thinking
# (--effort xhigh). Set CLAUDE_MODEL to override; set CLAUDE_EFFORT="" to drop
# the --effort flag entirely (use only if the installed claude CLI rejects it).
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_EFFORT=xhigh
# Optional: auto-fallback when the primary model is overloaded (HTTP 529).
# Does NOT cover 5-hour usage-limit events — those flow through the rate-limit
# branch in tickOnce and pause both tenants until the window resets.
# CLAUDE_FALLBACK_MODEL=claude-haiku-4-5-20251001

# ── Cap knobs (defaults 50 daily / 250 weekly) ───────────────────────────────
# Override here if you need to throttle. Empty string falls back to defaults.
# CAP_DAILY_MAX=50
# CAP_WEEKLY_MAX=250

# ── Rate-limit state file (shared across all tenants on this VPS) ────────────
# Both pipeline-orchestrator daemons read+write this file so a usage-limit
# hit by one tenant pauses BOTH queues until the 5-hour window resets.
RATE_LIMIT_STATE_PATH=/var/lib/claude-pipeline/rate-limit.json
