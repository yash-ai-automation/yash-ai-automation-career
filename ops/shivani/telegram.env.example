# Shivani pipeline autonomous-agent — env template.
#
# Production location on the VPS: /etc/shivani-pipeline/agent.env
#   - mode 0600, owner yash:yash, never committed to git
#
# SECURITY: the Telegram bot token MUST be issued (or re-issued) via @BotFather
# before being pasted into the production env file. Never paste a token into a
# Claude session, a commit, or a planning document. If any token has ever been
# transmitted in plaintext, treat it as compromised and rotate via @BotFather
# (/revoke → /newtoken) BEFORE deploying this stack.
#
# Provisioning checklist (see .claude/skills/shivani-pipeline-autonomous-agent/OPERATIONS.md):
#   sudo mkdir -p /etc/shivani-pipeline
#   sudo touch /etc/shivani-pipeline/agent.env
#   sudo chown yash:yash /etc/shivani-pipeline/agent.env
#   sudo chmod 600 /etc/shivani-pipeline/agent.env
#   $EDITOR /etc/shivani-pipeline/agent.env  # paste the values below
#   systemctl --user daemon-reload
#   systemctl --user enable --now shivani-telegram-listener shivani-pipeline-orchestrator

# ── Telegram binding ────────────────────────────────────────────────────────
# Replace <SHIVANI_BOT_TOKEN> with the FRESH BotFather-issued token.
TELEGRAM_BOT_TOKEN=<SHIVANI_BOT_TOKEN>
# CSV of integer Telegram user IDs allowed to talk to this bot. Single-user agent.
# Replace <SHIVANI_CHAT_ID> with the numeric user id captured at provisioning time.
TELEGRAM_ALLOWLIST=<SHIVANI_CHAT_ID>
# Numeric chat ID for outbound notifications (typically the same as the single allowlisted user).
TELEGRAM_NOTIFY_CHAT_ID=<SHIVANI_CHAT_ID>

# ── Project + tenant data paths ─────────────────────────────────────────────
PROJECT_ROOT=/yash-superClaudeHuman/projects/yash-ai-automation-career
WORK_QUEUE_DB=/yash-superClaudeHuman/projects/yash-ai-automation-career/ops/shivani/work-queue.db
CHECKPOINT_DIR=/yash-superClaudeHuman/projects/yash-ai-automation-career/ops/shivani/checkpoints
PREAMBLE_DIR=ops/shivani/preambles
AUDIT_LOG_PATH=data/shivani-resume-runs.log
PIPELINE_QUEUE_MD=data/shivani-pipeline.md

# ── Tenant labels (consumed by services/* via PR 1 env hooks) ───────────────
TENANT=shivani
TENANT_LABEL=shivani-pipeline
TENANT_TRACE_NAME=shivani-resume-pipeline
TMP_CLEANUP_GLOB=/tmp/shivani-pipeline-*

# ── Pipeline runner ─────────────────────────────────────────────────────────
PIPELINE_RUNNER=shivani-resume-pipeline.mjs
PIPELINE_MODE=modes/shivani-resume-pipeline.md
CLAUDE_MODEL=claude-opus-4-7

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Optional: ship logs to BetterStack/Logtail in addition to journald.
#   LOG_TRANSPORT=betterstack
#   LOGTAIL_TOKEN=<shivani-betterstack-source-token>

# ── Self-improvement feature flags (default OFF; mirror Yash) ───────────────
FEATURE_EXPORTER=0
FEATURE_FAILURE_KB=0
FEATURE_WATCHDOG=0

# ── Concurrency cap baseline (Q8) ───────────────────────────────────────────
# Measure during a live Yash run:
#   ps -eo rss,comm,pid --sort=-rss | head -20
# Set cap = floor((free_ram_mb - 500) / measured_peak_mb).
# Do NOT deploy if measured_peak_mb * 2 + 500 > available_ram_mb.
# This block is informational — the orchestrator enforces serial-per-user via
# the SQLite queue_one_running UNIQUE index; this comment is the operator's
# pre-deploy gate.
#   MEASURED_PEAK_MB=
#   AVAILABLE_RAM_MB=
#   CONCURRENT_WORKER_CAP=
